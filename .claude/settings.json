{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ui-test-guard.cjs\" 2>/dev/null || true",
            "statusMessage": "Checking for UI changes…"
          }
        ]
      }
    ]
  }
}
