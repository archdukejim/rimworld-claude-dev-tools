{
  "manifest_version": 3,
  "name": "Steam Workshop Helper",
  "version": "0.3.0",
  "description": "Programmatic API for managing Steam Workshop item descriptions, titles, and comments. Driven by Claude in Chrome or the local MCP server over a loopback bridge.",
  "homepage_url": "https://github.com/archdukejim/steam-workshop-helper",
  "permissions": ["storage", "cookies", "alarms", "tabs"],
  "host_permissions": [
    "https://steamcommunity.com/*",
    "https://api.steampowered.com/*",
    "http://127.0.0.1:8766/*",
    "http://localhost:8766/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://steamcommunity.com/*"],
      "js": ["src/swh-api.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://steamcommunity.com/*"],
      "js": ["src/bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Steam Workshop Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
