<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <!-- WORKING IDENTITY — placeholder, finalized in the pivot's C7 (rename) step. -->
  <packageId>archdukejim.rimagentic</packageId>
  <name>Rim Agentic Toolkit</name>
  <author>archdukejim</author>
  <supportedVersions>
    <li>1.5</li>
    <li>1.6</li>
  </supportedVersions>
  <description>A generic, agent-driven RimWorld modding toolkit. Exposes the base game and DLC surface to an external AI agent over a simple file-based tool bridge: discover and invoke in-game dev/inspection tools (defs, incidents, debug actions, pawn/object/map state) and let other mods register their own tools dynamically. Forked from the RimSynapse Core tool bridge, stripped of narrative content and local-LLM assumptions. Requires Harmony.</description>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
  </modDependencies>
  <!-- This toolkit is the tool bridge and must load LAST so it can observe/patch every
       other mod. About.xml has no true "load dead-last" flag; forceLoadAfter is the
       strongest hint the auto-sorter honours. Guaranteeing absolute-last order still
       requires ModsConfig.xml (RimSort, or this repo's resolve/configure tools). -->
  <forceLoadAfter>
    <li>brrainz.harmony</li>
    <li>Ludeon.RimWorld</li>
    <li>Ludeon.RimWorld.Royalty</li>
    <li>Ludeon.RimWorld.Ideology</li>
    <li>Ludeon.RimWorld.Biotech</li>
    <li>Ludeon.RimWorld.Anomaly</li>
    <li>Ludeon.RimWorld.Odyssey</li>
  </forceLoadAfter>
</ModMetaData>
