github_token.txt
.env

# packaged MCP bundle (build artifact)
rimtoolkit.mcpb

# harness runtime state
harness/.logmarker

# harness modlist backups (rewritten by the harness on every run)
harness/modlists/_previous.xml
harness/modlists/*.bak

# harmony release-notes auto-refresh (machine-generated; corpus regenerates from these + the
# git-tracked harmony-corpus.jsonl). See harmony-knowledge/refresh-harmony-releases.cjs.
harmony-knowledge/harmony-releases.auto.jsonl
harmony-knowledge/.refresh-state.json
harmony-knowledge/.refresh.log
harmony-knowledge/HARMONY-UPDATE.md

# steam workshop triage runtime state
mcp-config/triage-report.json
mcp-config/triage-state.json
harness/triage-last-run.log

# node build artifacts
server/node_modules/
server/build/
*.mcpb
mcp-config/triage-lastseen.json
mcp-config/.triage-currentmax.json

# game-side mod build artifacts + dev-local install paths
game-mod/Source/GamePath.props
game-mod/Source/bin/
game-mod/Source/obj/
game-mod/Assemblies/

# PromptLab dev-only console build output (source is tracked; binaries are not)
promptlab/bin/
promptlab/obj/

# screen-capture artifacts (capture_* tools write to the server's cwd = repo root)
screenshot_*.png
screenshot_*.jpeg
window_crop.png
window_crop.jpeg
gizmo_crop.png
gizmo_crop.jpeg
colonistbar_crop.png
colonistbar_crop.jpeg
playsettings_crop.png
playsettings_crop.jpeg
temp_screenshot_*.png

# runtime launch state (rewritten on every game launch)
server/dev_instance_pid.txt
